# SYNAPSE Edge Node — Raspberry Pi 4/5 Deployment Profile
# Optimized for low power, air-gapped border surveillance posts
SYNAPSE_NODE_ID=SYNAPSE-RPI-01
SYNAPSE_LISTEN_HOST=0.0.0.0
SYNAPSE_COMM_PORT=5000
SYNAPSE_DISCOVERY_PORT=5999
SYNAPSE_API_PORT=8080
SYNAPSE_BROADCAST_IP=192.168.1.255

# Watchdog Timers tuned for mesh battery preservation
SYNAPSE_HEARTBEAT_INTERVAL=5.0
SYNAPSE_UNRESPONSIVE_TIMEOUT=15.0
SYNAPSE_HEARTBEAT_TIMEOUT=30.0

# Store-and-Forward
SYNAPSE_RETRY_INTERVAL=8.0
SYNAPSE_MAX_RETRIES=200
SYNAPSE_DEFAULT_TTL=6
SYNAPSE_SOCKET_TIMEOUT=5.0

# Local Paths
SYNAPSE_DATA_DIR=/var/lib/synapse/data
SYNAPSE_KEYS_DIR=/etc/synapse/keys
SYNAPSE_LOG_LEVEL=INFO
