# SYNAPSE Edge Node — NVIDIA Jetson Orin Nano Deployment Profile
# High-throughput profile with multi-modal GPU fusion enabled
SYNAPSE_NODE_ID=SYNAPSE-ORIN-01
SYNAPSE_LISTEN_HOST=0.0.0.0
SYNAPSE_COMM_PORT=5000
SYNAPSE_DISCOVERY_PORT=5999
SYNAPSE_API_PORT=8080
SYNAPSE_BROADCAST_IP=255.255.255.255

# High-frequency heartbeat for low-latency tactical clusters
SYNAPSE_HEARTBEAT_INTERVAL=3.0
SYNAPSE_UNRESPONSIVE_TIMEOUT=8.0
SYNAPSE_HEARTBEAT_TIMEOUT=16.0

# Store-and-Forward
SYNAPSE_RETRY_INTERVAL=4.0
SYNAPSE_MAX_RETRIES=500
SYNAPSE_DEFAULT_TTL=8
SYNAPSE_SOCKET_TIMEOUT=3.0

# Accelerated paths
SYNAPSE_DATA_DIR=/opt/synapse/data
SYNAPSE_KEYS_DIR=/opt/synapse/keys
SYNAPSE_LOG_LEVEL=INFO
