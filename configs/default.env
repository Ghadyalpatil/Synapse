# SYNAPSE Edge Node — Default Configuration Profile
SYNAPSE_NODE_ID=SYNAPSE-001
SYNAPSE_LISTEN_HOST=0.0.0.0
SYNAPSE_COMM_PORT=5000
SYNAPSE_DISCOVERY_PORT=5999
SYNAPSE_API_PORT=8080
SYNAPSE_BROADCAST_IP=255.255.255.255

# Watchdog & Link Health (Seconds)
SYNAPSE_HEARTBEAT_INTERVAL=5.0
SYNAPSE_UNRESPONSIVE_TIMEOUT=12.0
SYNAPSE_HEARTBEAT_TIMEOUT=25.0

# Store-and-Forward Outbox
SYNAPSE_RETRY_INTERVAL=6.0
SYNAPSE_MAX_RETRIES=100
SYNAPSE_DEFAULT_TTL=5
SYNAPSE_SOCKET_TIMEOUT=4.0

# Storage & Logging
SYNAPSE_DATA_DIR=var/data
SYNAPSE_KEYS_DIR=var/keys
SYNAPSE_LOG_LEVEL=INFO
