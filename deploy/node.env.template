# SYNAPSE Node Environment Configuration
# Copy to /etc/synapse/node.env and edit before starting the service.
# All values here override the built-in defaults in synapse/config.py.

# ── Node Identity ────────────────────────────────────────────────────────────
# Unique identifier for this node. Each Pi MUST have a different ID.
SYNAPSE_NODE_ID=SYNAPSE-001

# ── Networking ───────────────────────────────────────────────────────────────
# TCP port this node listens on for mesh messages
SYNAPSE_COMM_PORT=5000

# UDP port for peer discovery beacons
SYNAPSE_DISCOVERY_PORT=5999

# REST / WebSocket dashboard API port
SYNAPSE_API_PORT=8080

# Subnet broadcast address for discovery beacons.
# Use the broadcast address of your LAN segment, e.g.:
#   - 192.168.1.255  for a 192.168.1.0/24 network
#   - 10.0.0.255     for a 10.0.0.0/24 network
#   - 255.255.255.255 for any directly-connected network
SYNAPSE_BROADCAST_IP=192.168.10.255

# ── Storage ──────────────────────────────────────────────────────────────────
SYNAPSE_DATA_DIR=/var/lib/synapse/data
SYNAPSE_KEYS_DIR=/etc/synapse/keys

# ── Timers ───────────────────────────────────────────────────────────────────
SYNAPSE_HEARTBEAT_INTERVAL=5.0
SYNAPSE_UNRESPONSIVE_TIMEOUT=12.0
SYNAPSE_HEARTBEAT_TIMEOUT=25.0
SYNAPSE_RETRY_INTERVAL=6.0

# ── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
SYNAPSE_LOG_LEVEL=INFO
